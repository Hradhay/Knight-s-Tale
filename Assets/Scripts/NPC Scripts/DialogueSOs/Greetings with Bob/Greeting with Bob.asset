  m_Name: Greeting with Bob
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d349a119f94a460469d792e417429718, type: 2}
    text: Hello, Night Runner!
  - speaker: {fileID: 11400000, guid: d349a119f94a460469d792e417429718, type: 2}
    text: 'I heard you just  released a n ew devlog for williard talking about animation  '
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: Sure did! You should check it out, Bob!
  options:
  - optionText: 'Tell me more '
    nextDialogue: {fileID: 11400000, guid: ad3e9706eae46a441866e7cb2381f145, type: 2}
  - optionText: Not interested
    nextDialogue: {fileID: 11400000, guid: af74d89377033664e92971f95661253f, type: 2}
