  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a2a03b395633c045b6efdf10eb37394, type: 3}
  m_Name: PurpleBob_Quest_Find Epic Items
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: d349a119f94a460469d792e417429718, type: 2}
    text: 'Hello,I need my epic items

'
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: Epic items, huh? And why exactly should I go looking for them?
  - speaker: {fileID: 11400000, guid: d349a119f94a460469d792e417429718, type: 2}
    text: "I\u2019ve heard you\u2019re one of the last surviving knights from the
      Battle of Greenfield. I can teach you how to use these items properly\u2014so
      they may aid you in battle."
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: "Hm\u2026 good enough. I\u2019ll find them. So, what exactly am I looking
      for?"
  - speaker: {fileID: 11400000, guid: d349a119f94a460469d792e417429718, type: 2}
    text: "Two items\u2026 no, wait\u2014three\u2026 or was it four? Hahaha! Ah,
      old age betrays me. You\u2019ll know them when you find them!"
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: "Right\u2026 very helpful"
  - speaker: {fileID: 11400000, guid: d349a119f94a460469d792e417429718, type: 2}
    text: "Ahaha\u2026 yes, it\u2019s four items: the Meat of Howls and the Shards
      of Strength. As for the others\u2026 hmm, I seem to have forgotten again. But
      you\u2019ll figure them out."
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: What a reason to go through all this trouble
  - speaker: {fileID: 11400000, guid: d349a119f94a460469d792e417429718, type: 2}
    text: "Listen, boy\u2026 I\u2019ve been here longer than you can imagine. I once
      spoke to your father\u2014the king\u2026 ah, forgive me, he is gone now. The
      choice is yours."
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: "Alright\u2026 I\u2019ll do it."
  options: []
