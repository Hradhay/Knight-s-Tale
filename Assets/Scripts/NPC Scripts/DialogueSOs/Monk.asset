MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4a2a03b395633c045b6efdf10eb37394, type: 3}
  m_Name: Monk
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: 8b35e35d6c5562c4ab84b0544ca261dd, type: 2}
    text: "Traveler\u2026 the path ahead is not just of stone, but of spirit. Strength
      alone will not guide you\u2014seek balance, and you may yet survive what lies
      beyond."
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: "I know what awaits me\u2026 but I must learn if it can be defeated."
  - speaker: {fileID: 11400000, guid: 8b35e35d6c5562c4ab84b0544ca261dd, type: 2}
    text: I do not guide others toward killing. It goes against my teachings.
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: "We don\u2019t have the time or strength for a holy quest\u2026 so what
      is it\u2014can it be killed, or is this my heroic last mistake?"
  - speaker: {fileID: 11400000, guid: 8b35e35d6c5562c4ab84b0544ca261dd, type: 2}
    text: "I shall enchant your weapons, so you may prevail\u2026 but beware, every
      action has its price."
  - speaker: {fileID: 11400000, guid: 22cf4ed06f0245643abbc233d4af9f90, type: 2}
    text: "What happens now\u2026? This is where I die, isn\u2019t it? Of course
      it is. Farewell, Father."
  options: []
  offerQuestOnEnd: {fileID: 0}
  requiredCompletedQuests: []
  turnInQuestOnEnd: {fileID: 0}
